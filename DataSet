import javax.swing.*;
import javax.swing.border.*;
import java.awt.*;



interface Measurable {
    double getMeasure();
    String getName();
    String getType();
}

class BankAccount implements Measurable {
    private static int lastAssignedNumber = 1000;
    private int accNumber;
    private double balance;

    public BankAccount(double balance) {
        lastAssignedNumber++;
        this.accNumber = lastAssignedNumber;
        this.balance = balance;
    }

    public int getAccountNumber() {
        return accNumber;
    }

 
    public double getMeasure() {
        return balance;
    }

  
    public String getName() {
        return "Acc #" + accNumber;
    }

  
    public String getType() {
        return "Bank Account";
    }
}

class Coin implements Measurable {
    private double value;
    private String name;

    public Coin(double value, String name) {
        this.value = value;
        this.name = name;
    }

   
    public double getMeasure() {
        return value;
    }

  
    public String getName() {
        return name;
    }

    
    public String getType() {
        return "Coin";
    }
}

class Student implements Measurable {
    private String name;
    private double height;

    public Student(String name, double height) {
        this.name = name;
        this.height = height;
    }

  
    public double getMeasure() {
        return height;
    }

   
    public String getName() {
        return name;
    }


    public String getType() {
        return "Student";
    }
}

class DataSet {
    private double sum;
    private Measurable max;
    private int count;

    public DataSet() {
        sum = 0;
        count = 0;
        max = null;
    }

    public void add(Measurable x) {
        sum += x.getMeasure();
        if (count == 0 || x.getMeasure() > max.getMeasure()) {
            max = x;
        }
        count++;
    }

    public Measurable getMax() {
        return max;
    }

    public double getAverage() {
        return count == 0 ? 0 : sum / count;
    }

    public double getSum() {
        return sum;
    }

    public int getCount() {
        return count;
    }

    public void clear() {
        sum = 0;
        count = 0;
        max = null;
    }
}


public class DataSetUI extends JFrame {
    private DataSet dataSet = new DataSet();

   
    private JLabel lblTotalCount;
    private JLabel lblAverage;
    private JLabel lblMaxVal;
    private JLabel lblSum;

  
    private JTextArea logArea;

    
    private static final Color BG_COLOR = new Color(245, 247, 250);
    private static final Color CARD_BG = Color.WHITE;
    private static final Color HEADER_BLUE = new Color(41, 128, 185);
    private static final Color SOFT_BLUE = new Color(70, 130, 180); // Soft Blue Theme Color for Buttons
    private static final Color ACCENT_GREEN = new Color(39, 174, 96);
    private static final Color TEXT_DARK = new Color(44, 62, 80);
    private static final Color BORDER_COLOR = new Color(220, 224, 230);

    public DataSetUI() {
        setTitle("DataSet Analytics Dashboard");
        setSize(950, 720);
        setMinimumSize(new Dimension(850, 650));
        setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        setLocationRelativeTo(null);
        getContentPane().setBackground(BG_COLOR);
        setLayout(new BorderLayout(15, 15));

    
        add(createHeaderPanel(), BorderLayout.NORTH);

       
        JPanel mainContainer = new JPanel(new GridBagLayout());
        mainContainer.setBackground(BG_COLOR);
        mainContainer.setBorder(new EmptyBorder(0, 15, 15, 15));

        GridBagConstraints gbc = new GridBagConstraints();
        gbc.fill = GridBagConstraints.BOTH;
        gbc.weighty = 1.0;

       
        gbc.gridx = 0;
        gbc.weightx = 0.40;
        gbc.insets = new Insets(0, 0, 0, 10);
        mainContainer.add(createInputFormsPanel(), gbc);

        
        gbc.gridx = 1;
        gbc.weightx = 0.60;
        gbc.insets = new Insets(0, 5, 0, 0);
        mainContainer.add(createDashboardPanel(), gbc);

        add(mainContainer, BorderLayout.CENTER);
    }

    private JPanel createHeaderPanel() {
        JPanel header = new JPanel(new BorderLayout());
        header.setBackground(HEADER_BLUE);
        header.setBorder(new EmptyBorder(18, 20, 18, 20));

        JLabel title = new JLabel("DataSet Analytics Engine");
        title.setFont(new Font("Segoe UI", Font.BOLD, 22));
        title.setForeground(Color.WHITE);

        JLabel subtitle = new JLabel("Polymorphic Data Aggregation & Real-Time Stats");
        subtitle.setFont(new Font("Segoe UI", Font.PLAIN, 12));
        subtitle.setForeground(new Color(214, 234, 248));

        JPanel textHolder = new JPanel(new GridLayout(2, 1, 0, 2));
        textHolder.setOpaque(false);
        textHolder.add(title);
        textHolder.add(subtitle);

        header.add(textHolder, BorderLayout.WEST);
        return header;
    }

    private JPanel createInputFormsPanel() {
        JPanel container = new JPanel();
        container.setLayout(new BoxLayout(container, BoxLayout.Y_AXIS));
        container.setOpaque(false);

        
        JPanel bankCard = createSectionCard("Add Bank Account");
        JTextField txtBalance = createStyledTextField("e.g. 2500.50");
        StyledButton btnAddBank = new StyledButton("Add Account", SOFT_BLUE, Color.WHITE);

        bankCard.add(createFieldRow("Balance ($):", txtBalance));
        bankCard.add(Box.createVerticalStrut(10));
        bankCard.add(btnAddBank);

        btnAddBank.addActionListener(e -> {
            try {
                double val = Double.parseDouble(txtBalance.getText().trim());
                BankAccount ba = new BankAccount(val);
                dataSet.add(ba);
                log(String.format("Added Bank Account: %s | Balance: $%.2f", ba.getName(), val));
                txtBalance.setText("");
                updateDashboard();
            } catch (NumberFormatException ex) {
                showError("Please enter a valid numeric balance.");
            }
        });

       
        JPanel coinCard = createSectionCard("Add Coin");
        JTextField txtCoinName = createStyledTextField("e.g. Quarter");
        JTextField txtCoinValue = createStyledTextField("e.g. 0.25");
        StyledButton btnAddCoin = new StyledButton("Add Coin", SOFT_BLUE, Color.WHITE);

        coinCard.add(createFieldRow("Coin Name:", txtCoinName));
        coinCard.add(Box.createVerticalStrut(8));
        coinCard.add(createFieldRow("Value ($):", txtCoinValue));
        coinCard.add(Box.createVerticalStrut(10));
        coinCard.add(btnAddCoin);

        btnAddCoin.addActionListener(e -> {
            try {
                String name = txtCoinName.getText().trim();
                double val = Double.parseDouble(txtCoinValue.getText().trim());
                if (name.isEmpty()) throw new IllegalArgumentException("Name required");
                Coin c = new Coin(val, name);
                dataSet.add(c);
                log(String.format("Added Coin: %s | Value: $%.2f", name, val));
                txtCoinName.setText("");
                txtCoinValue.setText("");
                updateDashboard();
            } catch (NumberFormatException ex) {
                showError("Please enter a valid coin value.");
            } catch (IllegalArgumentException ex) {
                showError("Coin name cannot be empty.");
            }
        });

     
        JPanel studentCard = createSectionCard("Add Student");
        JTextField txtStudentName = createStyledTextField("e.g. Sarah");
        JTextField txtStudentHeight = createStyledTextField("e.g. 172.5");
        StyledButton btnAddStudent = new StyledButton("Add Student", SOFT_BLUE, Color.WHITE);

        studentCard.add(createFieldRow("Student Name:", txtStudentName));
        studentCard.add(Box.createVerticalStrut(8));
        studentCard.add(createFieldRow("Height (cm):", txtStudentHeight));
        studentCard.add(Box.createVerticalStrut(10));
        studentCard.add(btnAddStudent);

        btnAddStudent.addActionListener(e -> {
            try {
                String name = txtStudentName.getText().trim();
                double height = Double.parseDouble(txtStudentHeight.getText().trim());
                if (name.isEmpty()) throw new IllegalArgumentException("Name required");
                Student s = new Student(name, height);
                dataSet.add(s);
                log(String.format("Added Student: %s | Height: %.1f cm", name, height));
                txtStudentName.setText("");
                txtStudentHeight.setText("");
                updateDashboard();
            } catch (NumberFormatException ex) {
                showError("Please enter a valid numeric height.");
            } catch (IllegalArgumentException ex) {
                showError("Student name cannot be empty.");
            }
        });

        
        StyledButton btnReset = new StyledButton("Reset All Data", SOFT_BLUE, Color.WHITE);
        btnReset.addActionListener(e -> {
            dataSet.clear();
            logArea.setText("");
            updateDashboard();
            log("System reset complete. All entries cleared.");
        });

        container.add(bankCard);
        container.add(Box.createVerticalStrut(10));
        container.add(coinCard);
        container.add(Box.createVerticalStrut(10));
        container.add(studentCard);
        container.add(Box.createVerticalStrut(15));
        container.add(btnReset);

        return container;
    }

    private JPanel createDashboardPanel() {
        JPanel dashboard = new JPanel(new BorderLayout(0, 12));
        dashboard.setOpaque(false);

   
        JPanel statsGrid = new JPanel(new GridLayout(2, 2, 10, 10));
        statsGrid.setOpaque(false);

        lblTotalCount = new JLabel("0", SwingConstants.CENTER);
        lblSum = new JLabel("0.00", SwingConstants.CENTER);
        lblAverage = new JLabel("0.00", SwingConstants.CENTER);
        lblMaxVal = new JLabel("None", SwingConstants.CENTER);

        statsGrid.add(createMetricCard("TOTAL ITEMS", lblTotalCount, new Color(142, 68, 173)));
        statsGrid.add(createMetricCard("TOTAL SUM", lblSum, ACCENT_GREEN));
        statsGrid.add(createMetricCard("AVERAGE VALUE", lblAverage, HEADER_BLUE));
        statsGrid.add(createMetricCard("MAX ITEM", lblMaxVal, new Color(211, 84, 0)));

      
        JPanel logCard = createSectionCard("Activity Log & Transactions");
        logCard.setLayout(new BorderLayout(0, 8));

        logArea = new JTextArea();
        logArea.setEditable(false);
        logArea.setFont(new Font("Consolas", Font.PLAIN, 12));
        logArea.setBackground(new Color(250, 251, 253));
        logArea.setForeground(TEXT_DARK);
        logArea.setMargin(new Insets(8, 8, 8, 8));

        JScrollPane scrollPane = new JScrollPane(logArea);
        scrollPane.setBorder(new LineBorder(BORDER_COLOR, 1, true));

        logCard.add(scrollPane, BorderLayout.CENTER);

        dashboard.add(statsGrid, BorderLayout.NORTH);
        dashboard.add(logCard, BorderLayout.CENTER);

        return dashboard;
    }

  

    private JPanel createMetricCard(String title, JLabel valueLabel, Color accentColor) {
        JPanel card = new JPanel(new BorderLayout(0, 5));
        card.setBackground(CARD_BG);
        card.setBorder(BorderFactory.createCompoundBorder(
                new LineBorder(BORDER_COLOR, 1, true),
                new EmptyBorder(12, 12, 12, 12)
        ));

        JLabel titleLabel = new JLabel(title, SwingConstants.CENTER);
        titleLabel.setFont(new Font("Segoe UI", Font.BOLD, 10));
        titleLabel.setForeground(new Color(127, 140, 141));

        valueLabel.setFont(new Font("Segoe UI", Font.BOLD, 18));
        valueLabel.setForeground(accentColor);

        card.add(titleLabel, BorderLayout.NORTH);
        card.add(valueLabel, BorderLayout.CENTER);
        return card;
    }

    private JPanel createSectionCard(String title) {
        JPanel card = new JPanel();
        card.setLayout(new BoxLayout(card, BoxLayout.Y_AXIS));
        card.setBackground(CARD_BG);
        card.setBorder(BorderFactory.createCompoundBorder(
                new LineBorder(BORDER_COLOR, 1, true),
                BorderFactory.createTitledBorder(
                        BorderFactory.createEmptyBorder(5, 5, 5, 5),
                        title,
                        TitledBorder.LEFT,
                        TitledBorder.TOP,
                        new Font("Segoe UI", Font.BOLD, 13),
                        TEXT_DARK
                )
        ));
        return card;
    }

    private JPanel createFieldRow(String labelText, JTextField field) {
        JPanel row = new JPanel(new BorderLayout(8, 0));
        row.setOpaque(false);
        JLabel label = new JLabel(labelText);
        label.setFont(new Font("Segoe UI", Font.PLAIN, 12));
        label.setPreferredSize(new Dimension(110, 25));
        label.setForeground(TEXT_DARK);

        row.add(label, BorderLayout.WEST);
        row.add(field, BorderLayout.CENTER);
        return row;
    }

    private JTextField createStyledTextField(String placeholder) {
        JTextField tf = new JTextField();
        tf.setFont(new Font("Segoe UI", Font.PLAIN, 12));
        tf.setBorder(BorderFactory.createCompoundBorder(
                new LineBorder(BORDER_COLOR, 1, true),
                new EmptyBorder(4, 6, 4, 6)
        ));
        tf.setToolTipText(placeholder);
        return tf;
    }

    
    static class StyledButton extends JButton {
        private Color normalBg;
        private Color hoverBg;

        public StyledButton(String text, Color bgColor, Color fgColor) {
            super(text);
            this.normalBg = bgColor;
            this.hoverBg = bgColor.brighter();
            setForeground(fgColor);
            setFont(new Font("Segoe UI", Font.BOLD, 12));
            setFocusPainted(false);
            setContentAreaFilled(false);
            setBorderPainted(false);
            setOpaque(false);
            setCursor(new Cursor(Cursor.HAND_CURSOR));
            setMaximumSize(new Dimension(Integer.MAX_VALUE, 35));
        }

        
        protected void paintComponent(Graphics g) {
            Graphics2D g2 = (Graphics2D) g.create();
            g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);

            if (getModel().isPressed()) {
                g2.setColor(normalBg.darker());
            } else if (getModel().isRollover()) {
                g2.setColor(hoverBg);
            } else {
                g2.setColor(normalBg);
            }

            g2.fillRoundRect(0, 0, getWidth(), getHeight(), 8, 8);
            g2.dispose();

            super.paintComponent(g);
        }
    }

    private void updateDashboard() {
        lblTotalCount.setText(String.valueOf(dataSet.getCount()));
        lblSum.setText(String.format("%.2f", dataSet.getSum()));
        lblAverage.setText(String.format("%.2f", dataSet.getAverage()));

        Measurable max = dataSet.getMax();
        if (max != null) {
            lblMaxVal.setText(String.format("%s (%.2f)", max.getName(), max.getMeasure()));
        } else {
            lblMaxVal.setText("None");
        }
    }

    private void log(String message) {
        logArea.append("> " + message + "\n");
        logArea.setCaretPosition(logArea.getDocument().getLength());
    }

    private void showError(String message) {
        JOptionPane.showMessageDialog(this, message, "Input Error", JOptionPane.ERROR_MESSAGE);
    }

    public static void main(String[] args) {
        try {
            UIManager.setLookAndFeel(UIManager.getSystemLookAndFeelClassName());
        } catch (Exception ignored) {}

        SwingUtilities.invokeLater(() -> new DataSetUI().setVisible(true));
    }
}
